{%- assign featured = collections[section.settings.collection_handle] -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Cormorant+Garamond:ital,wght@0,300;0,500;1,300;1,500&family=EB+Garamond:ital@0;1&display=swap" rel="stylesheet">

<style>
  :root {
    --velvet: #3a0f1c;
    --velvet-dk: #230912;
    --rose: #b84a62;
    --rose-lt: #e08aa0;
    --blush: #f6e3e6;
    --gold: #c9a45c;
    --gold-lt: #e6cf9d;
    --parchment: #fbf3e4;
    --ink: #3b2a2a;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--velvet-dk); color: var(--blush); font-family: 'EB Garamond', serif; font-size: 18px; line-height: 1.7; }
  .val-label { font-family: 'Cinzel', serif; letter-spacing: .3em; text-transform: uppercase; font-size: .75rem; color: var(--gold); }
  .val-h2 { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(2rem, 5vw, 3.2rem); margin: .4rem 0 2rem; color: var(--gold-lt); text-align: center; }
  section.val { padding: 6rem 1.5rem; max-width: 1100px; margin: 0 auto; text-align: center; }

  .hero { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem 1.5rem; text-align: center; background: radial-gradient(ellipse at center, var(--velvet) 0%, var(--velvet-dk) 70%); }
  .hero-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: clamp(2.8rem, 11vw, 7rem); margin: 1rem 0; color: var(--gold-lt); white-space: nowrap; }
  .hero-title em { font-style: italic; color: var(--rose-lt); font-size: 1em; }
  .hero-sub { font-style: italic; max-width: 34rem; opacity: .85; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 2.5rem; }
  .btn { font-family: 'Cinzel', serif; letter-spacing: .2em; text-transform: uppercase; font-size: .75rem; padding: .9rem 1.6rem; border: 1px solid var(--gold); color: var(--gold-lt); text-decoration: none; transition: background .25s, color .25s; }
  .btn:hover, .btn.solid { background: var(--gold); color: var(--velvet-dk); }
  .btn.solid:hover { background: var(--gold-lt); }

  .vows blockquote { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 300; font-size: clamp(1.4rem, 3.5vw, 2.2rem); max-width: 40rem; margin: 0 auto; color: var(--blush); }

  .timeline { position: relative; max-width: 640px; margin: 0 auto; text-align: left; padding-left: 2.5rem; }
  .timeline::before { content: ''; position: absolute; left: 7px; top: 0; bottom: 0; width: 1px; background: var(--gold); }
  .tl-item { position: relative; margin-bottom: 2.5rem; }
  .tl-item::before { content: ''; position: absolute; left: -2.5rem; top: .55rem; width: 15px; height: 15px; border-radius: 50%; background: var(--velvet-dk); border: 1px solid var(--gold); }
  .tl-item h3 { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 1.5rem; margin: 0; color: var(--gold-lt); }

  .letter-card { position: relative; background: var(--parchment); color: var(--ink); max-width: 680px; margin: 0 auto; padding: 3.5rem 2.5rem; text-align: left; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
  .letter-card p { margin: 0 0 1.2rem; }
  .seal { position: absolute; right: 2rem; bottom: -28px; width: 60px; height: 60px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, var(--rose), #7d2437); display: grid; place-items: center; color: var(--blush); font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; box-shadow: 0 4px 12px rgba(0,0,0,.4); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.8rem; }
  .card { text-decoration: none; color: inherit; border: 1px solid rgba(201,164,92,.35); padding: 1rem; background: rgba(255,255,255,.02); transition: transform .25s, border-color .25s; }
  .card:hover { transform: translateY(-4px); border-color: var(--gold); }
  .card img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; margin-bottom: .8rem; }
  .card h3 { font-family: 'Cormorant Garamond', serif; font-weight: 500; margin: 0; font-size: 1.25rem; }
  .card .price { font-family: 'Cinzel', serif; color: var(--gold); font-size: .85rem; letter-spacing: .1em; }
  .empty { font-style: italic; opacity: .7; }

  .drop { border: 1px dashed var(--gold); padding: 3rem 1.5rem; cursor: pointer; transition: background .25s; }
  .drop.over, .drop:hover { background: rgba(201,164,92,.08); }
  .drop input { display: none; }
  .moments { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; margin-top: 2rem; }
  .moments img { width: 100%; aspect-ratio: 1; object-fit: cover; }

  .countdown { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; }
  .cd-box { min-width: 90px; }
  .cd-num { font-family: 'Cormorant Garamond', serif; font-size: 3.2rem; color: var(--gold-lt); line-height: 1; }

  footer.val-foot { text-align: center; padding: 4rem 1.5rem; border-top: 1px solid rgba(201,164,92,.25); }
  .mono { font-family: 'Cormorant Garamond', serif; font-size: 2.2rem; color: var(--gold-lt); }
  .mono span { color: var(--rose-lt); }
</style>

<header class="hero" id="top">
  <div class="val-label">Est. with love</div>
  <h1 class="hero-title">Valen<em>versary</em></h1>
  <p class="hero-sub">For every year you chose each other again.</p>
  <div class="cta-row">
    <a class="btn solid" href="#letter">Read the Letter</a>
    <a class="btn" href="#story">Our Story</a>
    <a class="btn" href="#products">Shop the Collection</a>
  </div>
</header>

<section class="val vows">
  <div class="val-label">The Promise</div>
  <h2 class="val-h2">Our Vows</h2>
  <blockquote>&ldquo;To love you not as a day on the calendar, but as a habit of the heart &mdash; chosen again, and again, and again.&rdquo;</blockquote>
</section>

<section class="val" id="story">
  <div class="val-label">Our Story</div>
  <h2 class="val-h2">How It Began</h2>
  <div class="timeline">
    <div class="tl-item"><h3>The First Hello</h3><p>A small moment that turned out to be everything.</p></div>
    <div class="tl-item"><h3>The First Date</h3><p>Nervous laughter, long conversation, no one watching the clock.</p></div>
    <div class="tl-item"><h3>The First Valentine</h3><p>The day we decided it deserved a name of its own.</p></div>
    <div class="tl-item"><h3>The Promise</h3><p>Quietly, certainly, forever.</p></div>
    <div class="tl-item"><h3>Every February Since</h3><p>A Valenversary &mdash; our own holiday, renewed each year.</p></div>
  </div>
</section>

<section class="val" id="letter">
  <div class="val-label">A Letter</div>
  <h2 class="val-h2">To the One I Love</h2>
  <div class="letter-card">
    <p>My love,</p>
    <p>Some days are marked by celebration, and some by the ordinary kindness of being beside you. I treasure both, and I treasure you most of all.</p>
    <p>Thank you for every quiet morning, every shared laugh, and every year that has made home feel like a person.</p>
    <p>Forever yours,<br><em>V</em></p>
    <div class="seal">V</div>
  </div>
</section>

<section class="val" id="products">
  <div class="val-label">The Collection</div>
  <h2 class="val-h2">Keepsakes</h2>
  {%- if featured.products.size > 0 -%}
    <div class="grid">
      {%- for product in featured.products limit: section.settings.product_limit -%}
        <a class="card" href="{{ product.url }}">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">
          {%- endif -%}
          <h3>{{ product.title }}</h3>
          <div class="price">{{ product.price | money }}</div>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="empty">Keepsakes are on their way. Add products to the Home page collection.</p>
  {%- endif -%}
  <div class="cta-row"><a class="btn" href="#products">View All Products</a></div>
</section>

<section class="val" id="moments">
  <div class="val-label">Moments</div>
  <h2 class="val-h2">Share Yours</h2>
  <label class="drop" id="drop">
    <input type="file" id="file" accept="image/*" multiple>
    Drag &amp; drop your photos here, or tap to choose
  </label>
  <div class="moments" id="moments-grid"></div>
</section>

<section class="val" id="countdown">
  <div class="val-label">Until Next Valenversary</div>
  <h2 class="val-h2">February 14</h2>
  <div class="countdown">
    <div class="cd-box"><div class="cd-num" id="cd-d">0</div><div class="val-label">Days</div></div>
    <div class="cd-box"><div class="cd-num" id="cd-h">0</div><div class="val-label">Hours</div></div>
    <div class="cd-box"><div class="cd-num" id="cd-m">0</div><div class="val-label">Minutes</div></div>
    <div class="cd-box"><div class="cd-num" id="cd-s">0</div><div class="val-label">Seconds</div></div>
  </div>
</section>

<footer class="val-foot">
  <div class="mono">V<span>&hearts;</span>V</div>
  <div class="val-label">&copy; {{ 'now' | date: '%Y' }} Valenversary</div>
</footer>

<script>
  (function () {
    // Countdown to next Feb 14
    function target() {
      var now = new Date(), t = new Date(now.getFullYear(), 1, 14);
      if (now > new Date(now.getFullYear(), 1, 15)) t = new Date(now.getFullYear() + 1, 1, 14);
      return t;
    }
    var t = target();
    function tick() {
      var diff = Math.max(0, t - new Date()), s = Math.floor(diff / 1000);
      document.getElementById('cd-d').textContent = Math.floor(s / 86400);
      document.getElementById('cd-h').textContent = Math.floor(s % 86400 / 3600);
      document.getElementById('cd-m').textContent = Math.floor(s % 3600 / 60);
      document.getElementById('cd-s').textContent = s % 60;
    }
    tick(); setInterval(tick, 1000);

    // Moments uploader (in-memory only)
    var drop = document.getElementById('drop'), file = document.getElementById('file'), grid = document.getElementById('moments-grid');
    function add(files) {
      Array.prototype.forEach.call(files, function (f) {
        if (!/^image\//.test(f.type)) return;
        var img = document.createElement('img');
        img.src = URL.createObjectURL(f); img.alt = 'Shared moment';
        grid.appendChild(img);
      });
    }
    file.addEventListener('change', function () { add(file.files); });
    ['dragenter', 'dragover'].forEach(function (e) { drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.add('over'); }); });
    ['dragleave', 'drop'].forEach(function (e) { drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.remove('over'); }); });
    drop.addEventListener('drop', function (ev) { add(ev.dataTransfer.files); });
  })();
</script>

{% schema %}
{
  "name": "Valenversary Page",
  "settings": [
    { "type": "text", "id": "collection_handle", "label": "Collection handle", "default": "frontpage" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 12 }
  ],
  "presets": [{ "name": "Valenversary Page" }]
}
{% endschema %}

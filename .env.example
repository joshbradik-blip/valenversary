# Printful: create a private token at https://developers.printful.com
PRINTFUL_API_TOKEN=
# Only needed if the token is account-level rather than store-level
PRINTFUL_STORE_ID=
# "true" submits Printful orders for fulfilment automatically; otherwise they stay drafts
PRINTFUL_AUTO_CONFIRM=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "true" adds automatic sales tax (Stripe Tax must be activated first)
STRIPE_AUTOMATIC_TAX=false

# Public site URL used for Stripe redirect links
SITE_URL=https://ourvalenversary.com

# Firebase (customer Moments photos). From Firebase console → Project settings → Service accounts →
# Generate new private key. Paste private_key including the BEGIN/END lines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Only if your bucket isn't <project-id>.firebasestorage.app (older projects use <project-id>.appspot.com)
FIREBASE_STORAGE_BUCKET=

# Email alert for new Moments, sent with Resend (https://resend.com → API Keys).
RESEND_API_KEY=
# Defaults to josh@bradikenterprises.com
MOMENTS_NOTIFY_EMAIL=
# Defaults to "Valenversary <onboarding@resend.dev>", which only delivers to the Resend account's own
# email. Verify a domain in Resend to send from e.g. "Valenversary <moments@ourvalenversary.com>".
MOMENTS_FROM_EMAIL=

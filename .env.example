# Printful: create a private token at https://developers.printful.com
PRINTFUL_API_TOKEN=
# Only needed if the token is account-level rather than store-level
PRINTFUL_STORE_ID=
# "true" submits Printful orders for fulfilment automatically; otherwise they stay drafts
PRINTFUL_AUTO_CONFIRM=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "true" adds automatic sales tax (Stripe Tax must be activated first)
STRIPE_AUTOMATIC_TAX=false

# Public site URL used for Stripe redirect links
SITE_URL=https://ourvalenversary.com

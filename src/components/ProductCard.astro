---
import { formatPrice, type ProductSummary } from '../lib/printful';
const { product } = Astro.props as { product: ProductSummary };
---
<a class="card" href={`/product/${product.id}`}>
  <div class="card-art">
    {product.image && <img src={product.image} alt={product.name} loading="lazy" width="400" height="500" />}
    <span class="card-heart" aria-hidden="true">♡</span>
  </div>
  <div class="card-meta">
    <div>
      <h3>{product.name}</h3>
      {product.priceFromCents !== null && <div class="price">From {formatPrice(product.priceFromCents)}</div>}
    </div>
    <span class="card-plus" aria-hidden="true">+</span>
  </div>
</a>

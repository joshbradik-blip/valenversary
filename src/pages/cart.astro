---
import Base from '../layouts/Base.astro';
---
<Base title="Cart">
  <div class="wrap cart">
    <h1>Your cart</h1>
    <div id="lines"></div>
    <div id="summary" hidden>
      <form id="ship-form" class="ship">
        <p class="eyebrow">Ship to</p>
        <div class="ship-row ship-addr">
          <input id="address1" placeholder="Street address" maxlength="100" autocomplete="address-line1" required aria-label="Street address" />
          <input id="city" placeholder="City" maxlength="60" autocomplete="address-level2" required aria-label="City" />
        </div>
        <div class="ship-row">
          <select id="country" aria-label="Country"><option value="US">United States</option><option value="CA">Canada</option></select>
          <input id="state" placeholder="State (e.g. CA)" maxlength="2" autocomplete="address-level1" required aria-label="State or province code" />
          <input id="zip" placeholder="ZIP / postal code" maxlength="10" autocomplete="postal-code" required aria-label="ZIP or postal code" />
          <button class="btn" type="submit">Get shipping</button>
        </div>
      </form>
      <div id="rates" class="rates"></div>
      <div class="sum-row"><span>Subtotal</span><span id="subtotal"></span></div>
      <div class="sum-row"><span>Shipping</span><span id="shipping">—</span></div>
      <div class="total"><span>Total</span><span id="total"></span></div>
      <p class="eyebrow">Taxes, if any, are shown at checkout.</p>
      <button class="btn solid" id="checkout" disabled>Checkout <span class="dot">↗</span></button>
      <div class="error" id="error" role="alert"></div>
    </div>
    <div id="empty" class="notice" hidden>Your cart is empty. <a href="/shop">Browse the shop</a>.</div>
  </div>
  <script>
    import { onCartChange, readCart, setQty, money, type CartItem } from '../scripts/cart';

    const lines = document.getElementById('lines')!;
    const summary = document.getElementById('summary')!;
    const empty = document.getElementById('empty')!;
    const ratesBox = document.getElementById('rates')!;
    const error = document.getElementById('error')!;
    const button = document.getElementById('checkout') as HTMLButtonElement;

    interface Rate { id: string; name: string; rateCents: number; minDays?: number; maxDays?: number }
    let subtotal = 0;
    let rates: Rate[] = [];
    let chosen: Rate | null = null;
    let quotedFor = '';

    const destination = () => ({
      address1: (document.getElementById('address1') as HTMLInputElement).value.trim(),
      city: (document.getElementById('city') as HTMLInputElement).value.trim(),
      country: (document.getElementById('country') as HTMLSelectElement).value,
      state: (document.getElementById('state') as HTMLInputElement).value.trim(),
      zip: (document.getElementById('zip') as HTMLInputElement).value.trim(),
    });
    const cartKey = (items: CartItem[]) => items.map((i) => `${i.id}x${i.qty}`).join(',');

    function updateTotals() {
      document.getElementById('subtotal')!.textContent = money(subtotal);
      document.getElementById('shipping')!.textContent = chosen ? money(chosen.rateCents) : '—';
      document.getElementById('total')!.textContent = money(subtotal + (chosen?.rateCents ?? 0));
      button.disabled = !chosen;
    }

    function renderRates() {
      ratesBox.replaceChildren();
      for (const r of rates) {
        const label = document.createElement('label');
        label.className = 'rate';
        const input = Object.assign(document.createElement('input'), { type: 'radio', name: 'rate', checked: chosen?.id === r.id });
        input.addEventListener('change', () => { chosen = r; updateTotals(); });
        const days = r.minDays && r.maxDays ? ` · ${r.minDays}–${r.maxDays} business days` : '';
        const text = document.createElement('span');
        text.textContent = `${r.name}${days}`;
        const price = document.createElement('strong');
        price.textContent = money(r.rateCents);
        label.append(input, text, price);
        ratesBox.append(label);
      }
    }

    function render(items: CartItem[]) {
      lines.replaceChildren();
      summary.hidden = items.length === 0;
      empty.hidden = items.length !== 0;
      subtotal = 0;
      for (const i of items) {
        subtotal += i.priceCents * i.qty;
        const row = document.createElement('div');
        row.className = 'line';
        const img = document.createElement('img');
        img.src = i.image; img.alt = ''; img.width = 90; img.height = 90;
        const info = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = i.name;
        const variant = document.createElement('div');
        variant.className = 'eyebrow';
        variant.textContent = i.variant.replace(i.name, '').replace(/^[\s/-]+/, '');
        const qty = document.createElement('div');
        qty.className = 'qty';
        const minus = Object.assign(document.createElement('button'), { textContent: '−', ariaLabel: 'Decrease quantity' });
        const plus = Object.assign(document.createElement('button'), { textContent: '+', ariaLabel: 'Increase quantity' });
        minus.onclick = () => setQty(i.id, i.qty - 1);
        plus.onclick = () => setQty(i.id, i.qty + 1);
        const n = document.createElement('span');
        n.textContent = String(i.qty);
        qty.append(minus, n, plus);
        const remove = Object.assign(document.createElement('button'), { className: 'remove', textContent: 'Remove' });
        remove.onclick = () => setQty(i.id, 0);
        info.append(name, variant, qty, remove);
        const price = document.createElement('div');
        price.textContent = money(i.priceCents * i.qty);
        row.append(img, info, price);
        lines.append(row);
      }
      // A changed cart invalidates any earlier shipping quote.
      if (quotedFor && quotedFor !== cartKey(items)) {
        rates = []; chosen = null; quotedFor = '';
        ratesBox.replaceChildren();
      }
      updateTotals();
    }
    onCartChange(render);

    document.getElementById('ship-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.textContent = '';
      ratesBox.textContent = 'Checking rates…';
      chosen = null;
      updateTotals();
      const items = readCart();
      try {
        const res = await fetch('/api/shipping', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items.map((i) => ({ id: i.id, qty: i.qty })), destination: destination() }),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error ?? 'Could not get shipping');
        rates = body.rates;
        quotedFor = cartKey(items);
        chosen = rates[0] ?? null;
        renderRates();
        updateTotals();
      } catch (err) {
        ratesBox.replaceChildren();
        error.textContent = err instanceof Error ? err.message : 'Could not get shipping';
      }
    });

    button.addEventListener('click', async () => {
      if (!chosen) return;
      error.textContent = '';
      button.disabled = true;
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: readCart().map((i) => ({ id: i.id, qty: i.qty })),
            destination: destination(),
            shippingId: chosen.id,
          }),
        });
        const body = await res.json();
        if (!res.ok || !body.url) throw new Error(body.error ?? 'Checkout failed');
        window.location.href = body.url;
      } catch (err) {
        error.textContent = err instanceof Error ? err.message : 'Checkout failed';
        button.disabled = false;
      }
    });
  </script>
</Base>
